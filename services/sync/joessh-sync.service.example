[Unit]
Description=JoeSSH Sync Service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=joessh-sync
Group=joessh-sync
Environment=ATLASTERM_SYNC_BIND=127.0.0.1:4100
Environment=ATLASTERM_SYNC_STORAGE_PATH=/var/lib/joessh-sync/ledger.json
Environment=ATLASTERM_SYNC_RATE_LIMIT=100
Environment=ATLASTERM_SYNC_AUTH_TOKEN=replace-with-32-plus-char-random-sync-token
Environment=ATLASTERM_SYNC_ADMIN_TOKEN=replace-with-32-plus-char-random-admin-token
Environment=ATLASTERM_SYNC_METRICS_TOKEN=replace-with-32-plus-char-random-metrics-token
Environment=ATLASTERM_SYNC_CORS_ORIGINS=https://admin.example.com
ExecStart=/usr/local/bin/joessh-sync
Restart=on-failure
RestartSec=5
UMask=0077
StateDirectory=joessh-sync
StateDirectoryMode=0700
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ProtectClock=true
ProtectControlGroups=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
RestrictAddressFamilies=AF_INET AF_INET6
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=
ProcSubset=pid
ProtectProc=invisible
ReadWritePaths=/var/lib/joessh-sync
LimitNOFILE=4096
TasksMax=128
MemoryMax=256M
CPUQuota=100%

[Install]
WantedBy=multi-user.target
