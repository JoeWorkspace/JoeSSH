  "patch": {
    "kind": "module-compatibility",
    "rationale": "Expo Router 57 resolves query-string 7.1.3, whose CommonJS decoder import cannot consume the ESM-only patched release. JoeSSH retains the official 0.5.0 linear-time implementation and adds a CommonJS export of the same function until Expo Router supports query-string 9.5.0 or later.",
    "changes": [
      {
        "path": "index.cjs",
        "derivedFrom": "index.js",
        "transform": "Replace the single export default function declaration with module.exports = function; all decoder logic remains byte-identical."
      },
      {
        "path": "package.json",
        "derivedFrom": "package.original.json",
        "transform": "Preserve upstream identity, author, and runtime metadata; add main, module, and types entry points, conditional import and require exports, and index.cjs to the published file list. Omit scripts, devDependencies, overrides, and tsd because npm treats the file dependency as a local package and would otherwise pull package-only development tooling into the root lock graph."
      }
    ]
  },
