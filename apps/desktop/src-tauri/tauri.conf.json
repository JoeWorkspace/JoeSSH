{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "JoeSSH",
  "version": "0.1.0-beta.24",
  "identifier": "dev.atlasterm.joessh",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "JoeSSH",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "JoeSSH Project",
    "homepage": "https://github.com/JoeWorkspace/JoeSSH",
    "copyright": "Copyright (c) 2026 JoeSSH contributors",
    "license": "MIT",
    "category": "DeveloperTool",
    "shortDescription": "Local-first SSH, terminal, SFTP, and port-forwarding workbench.",
    "longDescription": "JoeSSH is a local-first Windows SSH workbench for secure host-key verification, PTY terminal sessions, SFTP transfers, and port forwarding.",
    "resources": {
      "../../../reports/release/third-party-licenses/THIRD-PARTY-NOTICES.txt": "legal/THIRD-PARTY-NOTICES.txt"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
