# =============================================================================
# JoeSSH Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values for your environment.
# All variables have sensible defaults; only override what you need.

# --- Web Admin Console ---

# URL for the admin snapshot API endpoint (default: /api/admin/snapshot)
# VITE_ATLASTERM_ADMIN_SNAPSHOT_URL=/api/admin/snapshot

# Proxy target for the admin snapshot dev server (default: http://127.0.0.1:4110)
# ATLASTERM_ADMIN_SNAPSHOT_PROXY_TARGET=http://127.0.0.1:4110

# Server-side bearer token injected by the same-origin admin snapshot proxy.
# Never expose this as a VITE_* browser variable.
# ATLASTERM_ADMIN_SNAPSHOT_PROXY_TOKEN=
# Same-origin admin snapshot proxy bind (default: 127.0.0.1:4300). Public binds
# require an authenticating reverse proxy and explicit opt-in.
# ATLASTERM_WEB_ADMIN_PROXY_BIND=127.0.0.1:4300
# ATLASTERM_WEB_ADMIN_PROXY_ALLOW_PUBLIC_BIND=0

# --- Mobile Companion ---

# Sync server URL for the mobile app
# EXPO_PUBLIC_ATLASTERM_SYNC_URL=http://127.0.0.1:4100

# Local mobile preview bearer token for sync authentication.
# EXPO_PUBLIC_* values are embedded in mobile bundles; do not use this path for
# public mobile beta builds or shared production Sync services.
# EXPO_PUBLIC_ATLASTERM_SYNC_AUTH_TOKEN=

# --- E2E Test Configuration (optional) ---

# Ports for E2E test servers (defaults shown)
# ATLASTERM_WEB_PORT=4200
# ATLASTERM_WEB_LIVE_PORT=4211
# ATLASTERM_DESKTOP_PORT=5175
# ATLASTERM_MOBILE_PORT=8099
# ATLASTERM_MOBILE_LIVE_PORT=8101
# ATLASTERM_E2E_ADMIN_SNAPSHOT_PORT=4110
# ATLASTERM_E2E_MOBILE_SYNC_PORT=4111

# Override full URLs for E2E test targets
# ATLASTERM_WEB_URL=http://localhost:4200
# ATLASTERM_WEB_LIVE_URL=http://localhost:4211
# ATLASTERM_DESKTOP_URL=http://localhost:5175
# ATLASTERM_MOBILE_URL=http://localhost:8099
# ATLASTERM_MOBILE_LIVE_URL=http://localhost:8101
# ATLASTERM_E2E_ADMIN_SNAPSHOT_URL=http://localhost:4110/v1/admin/snapshot
# ATLASTERM_E2E_MOBILE_SYNC_URL=http://localhost:4111

# E2E test auth tokens
# ATLASTERM_E2E_MOBILE_SYNC_AUTH_TOKEN=e2e-mobile-sync-token

# E2E test timeout in milliseconds (default: 30000)
# ATLASTERM_E2E_TEST_TIMEOUT_MS=30000


# Sync service (services/sync) server configuration
# ATLASTERM_SYNC_BIND=127.0.0.1:4100
# Required when binding to a non-loopback address; environment-provided bearer
# tokens must be 32+ characters, distinct, and contain no whitespace/control
# characters.
# ATLASTERM_SYNC_AUTH_TOKEN=
# Optional dedicated credential for GET /v1/admin/snapshot; when set, regular
# sync tokens cannot read the admin dashboard.
# ATLASTERM_SYNC_ADMIN_TOKEN=
# Required when binding to a non-loopback address; protects /metrics.
# ATLASTERM_SYNC_METRICS_TOKEN=
# ATLASTERM_SYNC_CORS_ORIGINS=https://app.example.com
# Required for Public Beta self-hosted deployments; enables the durable
# single-process JSON ledger.
# ATLASTERM_SYNC_STORAGE_PATH=/var/lib/joessh-sync/ledger.json
# Development/evaluation only. Do not use for Public Beta self-hosted releases.
# ATLASTERM_SYNC_ALLOW_EPHEMERAL_STORAGE=0
# ATLASTERM_SYNC_RATE_LIMIT=100
